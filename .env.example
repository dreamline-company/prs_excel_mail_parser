# Почтовый ящик со сводками ПРС (корпоративный Exchange ЭМГ)
PARSER_EMAIL=emg_prs-svodki@emg.kmg.kz
PARSER_PASSWORD=<пароль ящика>

# Логин IMAP, если Exchange не принимает адрес ящика (например, EMG\emg_prs-svodki).
# Пусто — логин = PARSER_EMAIL.
PARSER_LOGIN=

# Сервер IMAP SSL. Exchange — mail.emg.kmg.kz:993 (10.32.10.62/63);
# Gmail — imap.gmail.com:993 (нужен App Password при включённой 2FA).
IMAP_HOST=mail.emg.kmg.kz
IMAP_PORT=993
IMAP_FOLDER=INBOX
# Сертификат Exchange самоподписанный — без проверки.
IMAP_SSL_VERIFY=false

# Куда грузить сводки (POST .../repairs/v1/summaries/parsed)
SUMMARIES_API_URL=http://prs_eff_api:8000/prs-analytics/api/repairs/v1/summaries/parsed

# Период проверки почты, сек
MAIL_CHECK_INTERVAL=300
